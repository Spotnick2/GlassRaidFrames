<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- The child template for the SecureGroupHeaderTemplate probe (/fp raid header).
         No initialConfigFunction: restricted snippets are broken on Forever, so
         everything the child needs is declared here. Size must come from the
         template, since nothing else can set it on a header-spawned child. -->
    <Button name="RaidProbeHeaderUnitTemplate" inherits="SecureUnitButtonTemplate" virtual="true">
        <Size x="70" y="26"/>
        <Attributes>
            <Attribute name="type1" type="string" value="target"/>
            <Attribute name="type2" type="string" value="togglemenu"/>
        </Attributes>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="bg" setAllPoints="true">
                    <Color r="0.1" g="0.3" b="0.5" a="0.6"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="label" inherits="GameFontHighlightSmall" setAllPoints="true"/>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                self:RegisterForClicks("AnyUp")
            </OnLoad>
            <OnAttributeChanged>
                RaidProbe_HeaderChildAttribute(self, name, value)
            </OnAttributeChanged>
        </Scripts>
    </Button>
    <!-- The group layout probe (#69, Layout.lua): the plan's 96x60 cells and
         64x28 raid-pet cells. The header can't size its children, so the
         template does. The party-pet buttons use the pet template, resized. -->
    <Button name="RaidProbeLayoutCellTemplate" inherits="SecureUnitButtonTemplate" virtual="true">
        <Size x="96" y="60"/>
        <Attributes>
            <Attribute name="type1" type="string" value="target"/>
        </Attributes>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="bg" setAllPoints="true">
                    <Color r="0.15" g="0.35" b="0.6" a="0.6"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="label" inherits="GameFontHighlightSmall" setAllPoints="true"/>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                self:RegisterForClicks("AnyUp")
            </OnLoad>
            <OnAttributeChanged>
                RaidProbe_LayoutAttribute(self, name, value)
            </OnAttributeChanged>
        </Scripts>
    </Button>
    <Button name="RaidProbeLayoutPetTemplate" inherits="SecureUnitButtonTemplate" virtual="true">
        <Size x="64" y="28"/>
        <Attributes>
            <Attribute name="type1" type="string" value="target"/>
        </Attributes>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="bg" setAllPoints="true">
                    <Color r="0.2" g="0.55" b="0.25" a="0.6"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="label" inherits="GameFontHighlightSmall" setAllPoints="true"/>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                self:RegisterForClicks("AnyUp")
            </OnLoad>
            <OnAttributeChanged>
                RaidProbe_LayoutAttribute(self, name, value)
            </OnAttributeChanged>
        </Scripts>
    </Button>
</Ui>
